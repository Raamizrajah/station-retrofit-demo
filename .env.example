# === Required for LLM-powered analysis ===
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_BASE_URL=https://your-llm-gateway.example.com/anthropic
ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-4-6

